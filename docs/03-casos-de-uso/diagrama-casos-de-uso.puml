@startuml diagrama-casos-de-uso
' Portal Académico — Centro Educativo María Montessori (PC2)
' Coincide con actores.md y con el detalle de cada CU-xx.md.
' Única relación entre casos: CU-09 «extend» CU-07 (punto de extensión
' «Resolución con cambio de calificación», paso 8 de CU-07).
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F8FBFF
  BorderColor #275D85
  ArrowColor #4D6475
}

actor "Persona encargada\nlegal" as Enc
actor "Tiempo\n(servicio programado)" as Tie

actor "Docente" as Doc
actor "Comité de\nEvaluación" as Com
actor "Dirección" as Dir

rectangle "Portal Académico" {
  usecase "CU-01\nConsultar progreso\nacadémico" as CU01
  usecase "CU-12\nPresentar queja por\ninformación no recibida" as CU12
  usecase "CU-06\nComunicarse sobre\nun estudiante" as CU06
  usecase "CU-07\nGestionar apelación\nde una calificación\n--\nextension points:\nResolución con cambio\nde calificación" as CU07
  usecase "CU-05\nDar seguimiento a\navisos no consultados" as CU05
  usecase "CU-03\nPublicar evaluación\nasignada" as CU03
  usecase "CU-04\nPublicar\ncalificación" as CU04
  usecase "CU-09\nCorregir una\ncalificación publicada" as CU09
  usecase "CU-02\nVincular encargado\ncon estudiante" as CU02
  usecase "CU-08\nSupervisar el\nseguimiento académico" as CU08
  usecase "CU-10\nConfigurar plazos\ny recordatorios" as CU10
}

' Actores a la izquierda
Enc -- CU01
Enc -- CU12
Enc -- CU06
Enc -- CU07
Enc -- CU05
Tie -- CU05

' Actores a la derecha
CU03 -- Doc
CU04 -- Doc
CU09 -- Doc
CU06 -- Doc
CU07 -- Doc
CU07 -- Com
CU07 -- Dir
CU05 -- Dir
CU12 -- Dir
CU02 -- Dir
CU08 -- Dir
CU10 -- Dir

CU09 .> CU07 : <<extend>>

note "El estudiante participa en el proceso actual\n(BPMN), pero no tiene cuenta en el MVP." as N1
@enduml
