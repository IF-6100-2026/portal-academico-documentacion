  </bpmn:collaboration>
  <bpmn:process id="Process_CasosDeUso" isExecutable="false">
    <bpmn:task id="CU_03" name="CU-03 Publicar evaluación asignada" />
    <bpmn:task id="CU_04" name="CU-04 Publicar calificación" />
    <bpmn:task id="CU_01" name="CU-01 Consultar progreso académico" />
    <bpmn:task id="CU_06" name="CU-06 Comunicarse sobre un estudiante" />
    <bpmn:task id="CU_09" name="CU-09 Corregir una calificación publicada" />
    <bpmn:task id="CU_07" name="CU-07 Gestionar apelación de una calificación" />
    <bpmn:task id="CU_12" name="CU-12 Presentar queja por información no recibida" />
    <bpmn:task id="CU_05" name="CU-05 Dar seguimiento a avisos no consultados" />
    <bpmn:task id="CU_02" name="CU-02 Vincular encargado con estudiante" />
    <bpmn:task id="CU_08" name="CU-08 Supervisar el seguimiento académico" />
    <bpmn:task id="CU_10" name="CU-10 Configurar plazos y recordatorios" />
    <bpmn:textAnnotation id="Nota_Extend"><bpmn:text>«extend»: CU-09 extiende a CU-07 en el punto «Resolución con cambio de calificación».</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Nota_Estudiante"><bpmn:text>El estudiante participa en el proceso actual (BPMN), pero no tiene cuenta en el MVP.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Nota_Lectura"><bpmn:text>Lectura: cada pool externo es un actor, cada tarea es un caso de uso y cada flecha es una asociación actor–caso.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Extend_CU09_CU07" associationDirection="One" sourceRef="CU_09" targetRef="CU_07" />
    <bpmn:association id="Assoc_Nota_Extend" sourceRef="Nota_Extend" targetRef="Extend_CU09_CU07" />
  </bpmn:process>
