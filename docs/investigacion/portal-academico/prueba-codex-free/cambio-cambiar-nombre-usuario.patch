+package dev.leocamacho.demo.handlers.commands;
+
+public interface UpdateCurrentUserNameHandler {
+
+    Result handle(Command command);
+
+    sealed interface Result {
+        record Success(String name, String email) implements Result {
+        }
+
+        record RequiredFields(String... fields) implements Result {
+        }
+
+        record InvalidFields(String... fields) implements Result {
+        }
+
+        record UserNotFound() implements Result {
+        }
+    }
+
+    record Command(String email, String name) { }
+}
