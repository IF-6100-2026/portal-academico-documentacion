+package dev.leocamacho.demo.handlers.commands.impl;
+
+import dev.leocamacho.demo.handlers.commands.UpdateCurrentUserNameHandler;
+import dev.leocamacho.demo.persistence.repositories.UserRepository;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.stereotype.Component;
+
+@Component
+public class UpdateCurrentUserNameHandlerImpl implements UpdateCurrentUserNameHandler {
+    private static final int MAX_NAME_LENGTH = 100;
+
+    @Autowired
+    private UserRepository repository;
+
+    @Override
+    public Result handle(Command command) {
+        String normalizedName = command.name() == null ? null : command.name().strip();
+        if (normalizedName == null || normalizedName.isBlank()) {
+            return new Result.RequiredFields("name");
+        }
+        if (normalizedName.length() > MAX_NAME_LENGTH) {
+            return new Result.InvalidFields("name");
+        }
+
+        var user = repository.findByEmail(command.email());
+        if (user.isEmpty()) {
+            return new Result.UserNotFound();
+        }
+
+        var currentUser = user.get();
+        currentUser.setName(normalizedName);
+        var savedUser = repository.save(currentUser);
+        return new Result.Success(savedUser.getName(), savedUser.getEmail());
+    }
+}
