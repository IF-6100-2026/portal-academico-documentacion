+package dev.leocamacho.demo.tests.api;
+
+import dev.leocamacho.demo.api.controllers.UpdateCurrentUserNameController;
+import dev.leocamacho.demo.api.request.UpdateCurrentUserNameRequest;
+import dev.leocamacho.demo.api.responses.ErrorResponse;
+import dev.leocamacho.demo.api.responses.UserResponse;
+import dev.leocamacho.demo.exception.ErrorCode;
+import dev.leocamacho.demo.handlers.commands.UpdateCurrentUserNameHandler;
+import dev.leocamacho.demo.session.Session;
+import dev.leocamacho.demo.session.SessionContextHolder;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.extension.ExtendWith;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.NullAndEmptySource;
+import org.junit.jupiter.params.provider.ValueSource;
+import org.mockito.InjectMocks;
+import org.mockito.Mock;
+import org.mockito.junit.jupiter.MockitoExtension;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.security.core.context.SecurityContextHolder;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestMapping;
+
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertInstanceOf;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+@ExtendWith(MockitoExtension.class)
+public class UpdateCurrentUserNameControllerTests {
+    private static final int TOO_LONG_NAME_LENGTH = 101;
+    private static final String SESSION_EMAIL = "alice@mail.com";
+    private static final UUID CORRELATION_ID = UUID.fromString("82f2d0e4-bb08-4ecd-aa9a-df720c2cc75a");
+
+    @Mock
+    private UpdateCurrentUserNameHandler handler;
+    @InjectMocks
+    private UpdateCurrentUserNameController controller;
+
+    @AfterEach
+    public void clearSecurityContext() {
+        SecurityContextHolder.clearContext();
+    }
+
+    @Test
+    public void updateCurrentUserNameShouldUsePutRoute() throws NoSuchMethodException {
+        var classMapping = UpdateCurrentUserNameController.class.getAnnotation(RequestMapping.class);
+        var methodMapping = UpdateCurrentUserNameController.class
+                .getMethod("updateCurrentUserName", UpdateCurrentUserNameRequest.class)
+                .getAnnotation(PutMapping.class);
+
+        assertEquals("/api/private/users", classMapping.value()[0]);
+        assertEquals("/current/name", methodMapping.value()[0]);
+    }
+
+    @Test
+    public void updateCurrentUserNameShouldReturnUpdatedUser() {
+        setSession();
+        when(handler.handle(new UpdateCurrentUserNameHandler.Command(SESSION_EMAIL, "  Alice  ")))
+                .thenReturn(new UpdateCurrentUserNameHandler.Result.Success("Alice", SESSION_EMAIL));
+
+        ResponseEntity<?> response = controller.updateCurrentUserName(new UpdateCurrentUserNameRequest("  Alice  "));
+
+        assertEquals(HttpStatus.OK, response.getStatusCode());
+        assertEquals(new UserResponse("Alice", SESSION_EMAIL), response.getBody());
+        verify(handler).handle(new UpdateCurrentUserNameHandler.Command(SESSION_EMAIL, "  Alice  "));
+    }
+
+    @ParameterizedTest
+    @NullAndEmptySource
+    @ValueSource(strings = {"   "})
+    public void updateCurrentUserNameShouldReturnRequiredFields(String name) {
+        setSession();
+        when(handler.handle(new UpdateCurrentUserNameHandler.Command(SESSION_EMAIL, name)))
+                .thenReturn(new UpdateCurrentUserNameHandler.Result.RequiredFields("name"));
+
+        ResponseEntity<?> response = controller.updateCurrentUserName(new UpdateCurrentUserNameRequest(name));
+
+        assertError(response, ErrorCode.REQUIRED_FIELDS, "name");
+        verify(handler).handle(new UpdateCurrentUserNameHandler.Command(SESSION_EMAIL, name));
+    }
+
+    @Test
+    public void updateCurrentUserNameShouldReturnInvalidFieldsWhenNameIsTooLong() {
+        setSession();
+        String name = "a".repeat(TOO_LONG_NAME_LENGTH);
+        when(handler.handle(new UpdateCurrentUserNameHandler.Command(SESSION_EMAIL, name)))
+                .thenReturn(new UpdateCurrentUserNameHandler.Result.InvalidFields("name"));
+
+        ResponseEntity<?> response = controller.updateCurrentUserName(new UpdateCurrentUserNameRequest(name));
+
+        assertError(response, ErrorCode.INVALID_FIELDS, "name");
+        verify(handler).handle(new UpdateCurrentUserNameHandler.Command(SESSION_EMAIL, name));
+    }
+
+    @Test
+    public void updateCurrentUserNameShouldReturnInvalidUserWhenSessionEmailDoesNotExist() {
+        setSession();
+        when(handler.handle(new UpdateCurrentUserNameHandler.Command(SESSION_EMAIL, "New Name")))
+                .thenReturn(new UpdateCurrentUserNameHandler.Result.UserNotFound());
+
+        ResponseEntity<?> response = controller.updateCurrentUserName(new UpdateCurrentUserNameRequest("New Name"));
+
+        assertError(response, ErrorCode.INVALID_USER);
+        verify(handler).handle(new UpdateCurrentUserNameHandler.Command(SESSION_EMAIL, "New Name"));
+    }
+
+    private void setSession() {
+        var session = Session.newBuilder()
+                .withId(UUID.randomUUID())
+                .withEmail(SESSION_EMAIL)
+                .withRoles("USER")
+                .withCorrelationId(CORRELATION_ID)
+                .build();
+        SessionContextHolder.setSession(session);
+    }
+
+    private void assertError(ResponseEntity<?> response, ErrorCode errorCode, String... params) {
+        assertEquals(HttpStatus.BAD_REQUEST, response.getStatusCode());
+        var error = assertInstanceOf(ErrorResponse.class, response.getBody());
+        assertEquals(errorCode.code(), error.code());
+        assertEquals(CORRELATION_ID, error.correlationId());
+        assertArrayEquals(params, error.params());
+    }
+}
