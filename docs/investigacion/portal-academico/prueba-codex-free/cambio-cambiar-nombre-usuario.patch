+package dev.leocamacho.demo.tests.handlers.commands;
+
+import dev.leocamacho.demo.handlers.commands.UpdateCurrentUserNameHandler;
+import dev.leocamacho.demo.handlers.commands.impl.UpdateCurrentUserNameHandlerImpl;
+import dev.leocamacho.demo.persistence.model.UserEntity;
+import dev.leocamacho.demo.persistence.repositories.UserRepository;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.extension.ExtendWith;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.NullAndEmptySource;
+import org.junit.jupiter.params.provider.ValueSource;
+import org.mockito.InjectMocks;
+import org.mockito.Mock;
+import org.mockito.junit.jupiter.MockitoExtension;
+
+import java.util.Optional;
+
+import static dev.leocamacho.demo.persistence.model.UserEntity.UserEntityBuilder.anUserEntity;
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertInstanceOf;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+@ExtendWith(MockitoExtension.class)
+public class UpdateCurrentUserNameHandlerTests {
+    private static final int MAX_NAME_LENGTH = 100;
+
+    @Mock
+    private UserRepository repository;
+    @InjectMocks
+    private UpdateCurrentUserNameHandlerImpl handler;
+
+    @Test
+    public void updateCurrentUserNameShouldTrimAndSaveName() {
+        var user = anUserEntity().withName("Old Name").withEmail("alice@mail.com")
+                .withPassword("hash").build();
+        when(repository.findByEmail("alice@mail.com")).thenReturn(Optional.of(user));
+        when(repository.save(any(UserEntity.class))).thenAnswer(invocation -> invocation.getArgument(0));
+
+        var result = handler.handle(new UpdateCurrentUserNameHandler.Command("alice@mail.com", "  Alice  "));
+
+        assertEquals(new UpdateCurrentUserNameHandler.Result.Success("Alice", "alice@mail.com"), result);
+        assertEquals("Alice", user.getName());
+        verify(repository).save(user);
+    }
+
+    @ParameterizedTest
+    @NullAndEmptySource
+    @ValueSource(strings = {"   "})
+    public void updateCurrentUserNameShouldReturnRequiredFields(String name) {
+        var result = handler.handle(new UpdateCurrentUserNameHandler.Command("alice@mail.com", name));
+
+        var requiredFields = assertInstanceOf(UpdateCurrentUserNameHandler.Result.RequiredFields.class, result);
+        assertArrayEquals(new String[] {"name"}, requiredFields.fields());
+        verify(repository, never()).save(any(UserEntity.class));
+    }
+
+    @Test
+    public void updateCurrentUserNameShouldAllowExactlyOneHundredTrimmedCharacters() {
+        String name = "a".repeat(MAX_NAME_LENGTH);
+        var user = anUserEntity().withName("Old Name").withEmail("alice@mail.com")
+                .withPassword("hash").build();
+        when(repository.findByEmail("alice@mail.com")).thenReturn(Optional.of(user));
+        when(repository.save(any(UserEntity.class))).thenAnswer(invocation -> invocation.getArgument(0));
+
+        var result = handler.handle(new UpdateCurrentUserNameHandler.Command("alice@mail.com", name));
+
+        assertEquals(new UpdateCurrentUserNameHandler.Result.Success(name, "alice@mail.com"), result);
+        verify(repository).save(user);
+    }
+
+    @Test
+    public void updateCurrentUserNameShouldReturnInvalidFieldsWhenTrimmedNameIsTooLong() {
+        String name = " " + "a".repeat(MAX_NAME_LENGTH + 1) + " ";
+
+        var result = handler.handle(new UpdateCurrentUserNameHandler.Command("alice@mail.com", name));
+
+        var invalidFields = assertInstanceOf(UpdateCurrentUserNameHandler.Result.InvalidFields.class, result);
+        assertArrayEquals(new String[] {"name"}, invalidFields.fields());
+        verify(repository, never()).save(any(UserEntity.class));
+    }
+
+    @Test
+    public void updateCurrentUserNameShouldReturnUserNotFound() {
+        when(repository.findByEmail("nobody@mail.com")).thenReturn(Optional.empty());
+
+        var result = handler.handle(new UpdateCurrentUserNameHandler.Command("nobody@mail.com", "New Name"));
+
+        assertEquals(new UpdateCurrentUserNameHandler.Result.UserNotFound(), result);
+        verify(repository, never()).save(any(UserEntity.class));
+    }
+}
