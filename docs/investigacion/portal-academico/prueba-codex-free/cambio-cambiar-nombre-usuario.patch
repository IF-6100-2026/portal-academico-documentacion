+package dev.leocamacho.demo.api.controllers;
+
+import dev.leocamacho.demo.api.request.UpdateCurrentUserNameRequest;
+import dev.leocamacho.demo.api.responses.ErrorResponse;
+import dev.leocamacho.demo.api.responses.UserResponse;
+import dev.leocamacho.demo.exception.ErrorCode;
+import dev.leocamacho.demo.handlers.commands.UpdateCurrentUserNameHandler;
+import dev.leocamacho.demo.session.SessionContextHolder;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+@RestController
+@RequestMapping("/api/private/users")
+public class UpdateCurrentUserNameController {
+
+    @Autowired
+    private UpdateCurrentUserNameHandler handler;
+
+    @PutMapping("/current/name")
+    public ResponseEntity<?> updateCurrentUserName(@RequestBody UpdateCurrentUserNameRequest request) {
+        var session = SessionContextHolder.getSession();
+        var result = handler.handle(new UpdateCurrentUserNameHandler.Command(session.email(), request.name()));
+        return switch (result) {
+            case UpdateCurrentUserNameHandler.Result.Success success ->
+                    ResponseEntity.ok(new UserResponse(success.name(), success.email()));
+            case UpdateCurrentUserNameHandler.Result.RequiredFields requiredFields ->
+                    ResponseEntity.badRequest().body(ErrorResponse.of(
+                            ErrorCode.REQUIRED_FIELDS, session.correlationId(), requiredFields.fields()));
+            case UpdateCurrentUserNameHandler.Result.InvalidFields invalidFields ->
+                    ResponseEntity.badRequest().body(ErrorResponse.of(
+                            ErrorCode.INVALID_FIELDS, session.correlationId(), invalidFields.fields()));
+            case UpdateCurrentUserNameHandler.Result.UserNotFound ignored ->
+                    ResponseEntity.badRequest().body(ErrorResponse.of(
+                            ErrorCode.INVALID_USER, session.correlationId()));
+        };
+    }
+}
