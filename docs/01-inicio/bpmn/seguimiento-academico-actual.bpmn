<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Process_SeguimientoActual" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Portal Académico (generador del equipo)" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_SeguimientoActual">
    <bpmn:participant id="Part_Centro" name="Centro Educativo María Montessori — comunicación del seguimiento académico (AS-IS)" processRef="Process_SeguimientoActual" />
  </bpmn:collaboration>
  <bpmn:process id="Process_SeguimientoActual" name="Comunicar el seguimiento académico (proceso actual)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Docente" name="Docente">
        <bpmn:flowNodeRef>SE_01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_00</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AC_01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AC_06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AC_07</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Estudiante" name="Estudiante">
        <bpmn:flowNodeRef>AC_02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AC_08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_04</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Encargado" name="Persona encargada legal">
        <bpmn:flowNodeRef>AC_03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AC_04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AC_05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AC_09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AC_10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE_01</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Comite" name="Comité de Evaluación">
        <bpmn:flowNodeRef>SP_01</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Direccion" name="Dirección">
        <bpmn:flowNodeRef>AC_11</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="SE_01" name="Inicia el periodo lectivo">
      <bpmn:outgoing>F_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="G_00" name="">
      <bpmn:incoming>F_01</bpmn:incoming>
      <bpmn:incoming>F_12</bpmn:incoming>
      <bpmn:outgoing>F_02</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="AC_01" name="AC-01 Anotar la evaluación en el cuaderno y registrarla en la plataforma y el registro físico">
      <bpmn:documentation>E-01, E-02</bpmn:documentation>
      <bpmn:incoming>F_02</bpmn:incoming>
      <bpmn:outgoing>F_03</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DA_01"><bpmn:targetRef>DS_Plataforma</bpmn:targetRef></bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="DA_02"><bpmn:targetRef>DS_RegistroFisico</bpmn:targetRef></bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="DA_03"><bpmn:targetRef>DO_Cuaderno</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="AC_02" name="AC-02 Llevar el cuaderno al hogar">
      <bpmn:documentation>E-02, E-04, E-12</bpmn:documentation>
      <bpmn:incoming>F_03</bpmn:incoming>
      <bpmn:outgoing>F_04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AC_03" name="AC-03 Revisar la anotación y firmar de recibido en el cuaderno">
      <bpmn:documentation>E-02, E-04</bpmn:documentation>
      <bpmn:incoming>F_04</bpmn:incoming>
      <bpmn:outgoing>F_05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_01" name="¿Está de acuerdo con la calificación?">
      <bpmn:incoming>F_05</bpmn:incoming>
      <bpmn:outgoing>F_06</bpmn:outgoing>
      <bpmn:outgoing>F_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="AC_04" name="AC-04 Escribir la apelación en el cuaderno de recados">
      <bpmn:documentation>E-07</bpmn:documentation>
      <bpmn:incoming>F_07</bpmn:incoming>
      <bpmn:outgoing>F_08</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DA_04"><bpmn:targetRef>DO_Recados</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:callActivity id="SP_01" name="SP-01 Resolver la apelación" calledElement="Process_ResolverApelacion">
      <bpmn:documentation>E-07, E-08, E-11. Detalle en resolver-apelacion-actual.bpmn</bpmn:documentation>
      <bpmn:incoming>F_08</bpmn:incoming>
      <bpmn:outgoing>F_09</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:task id="AC_05" name="AC-05 Recibir la resolución">
      <bpmn:documentation>E-11</bpmn:documentation>
      <bpmn:incoming>F_09</bpmn:incoming>
      <bpmn:outgoing>F_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_02" name="">
      <bpmn:incoming>F_06</bpmn:incoming>
      <bpmn:incoming>F_10</bpmn:incoming>
      <bpmn:outgoing>F_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G_03" name="¿Terminó el periodo?">
      <bpmn:incoming>F_11</bpmn:incoming>
      <bpmn:outgoing>F_12</bpmn:outgoing>
      <bpmn:outgoing>F_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="AC_06" name="AC-06 Preparar el reporte físico de calificaciones">
      <bpmn:documentation>E-03, E-12</bpmn:documentation>
      <bpmn:incoming>F_13</bpmn:incoming>
      <bpmn:outgoing>F_14</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DA_05"><bpmn:targetRef>DO_Reporte</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="AC_07" name="AC-07 Entregar el reporte al estudiante">
      <bpmn:documentation>E-12</bpmn:documentation>
      <bpmn:incoming>F_14</bpmn:incoming>
      <bpmn:outgoing>F_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AC_08" name="AC-08 Llevar el reporte al hogar">
      <bpmn:documentation>E-12</bpmn:documentation>
      <bpmn:incoming>F_15</bpmn:incoming>
      <bpmn:outgoing>F_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_04" name="¿Lo entrega a tiempo?">
      <bpmn:incoming>F_16</bpmn:incoming>
      <bpmn:outgoing>F_17</bpmn:outgoing>
      <bpmn:outgoing>F_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="AC_09" name="AC-09 Revisar el reporte">
      <bpmn:documentation>E-03</bpmn:documentation>
      <bpmn:incoming>F_17</bpmn:incoming>
      <bpmn:outgoing>F_21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AC_10" name="AC-10 Presentar una queja por no recibir la información">
      <bpmn:documentation>E-14</bpmn:documentation>
      <bpmn:incoming>F_18</bpmn:incoming>
      <bpmn:outgoing>F_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AC_11" name="AC-11 Atender la queja">
      <bpmn:documentation>E-06, E-14</bpmn:documentation>
      <bpmn:incoming>F_19</bpmn:incoming>
      <bpmn:outgoing>F_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_05" name="">
      <bpmn:incoming>F_20</bpmn:incoming>
      <bpmn:incoming>F_21</bpmn:incoming>
      <bpmn:outgoing>F_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EE_01" name="Comunicación del periodo cerrada">
      <bpmn:incoming>F_22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_01" sourceRef="SE_01" targetRef="G_00" />
    <bpmn:sequenceFlow id="F_02" sourceRef="G_00" targetRef="AC_01" />
    <bpmn:sequenceFlow id="F_03" sourceRef="AC_01" targetRef="AC_02" />
    <bpmn:sequenceFlow id="F_04" sourceRef="AC_02" targetRef="AC_03" />
    <bpmn:sequenceFlow id="F_05" sourceRef="AC_03" targetRef="G_01" />
    <bpmn:sequenceFlow id="F_06" name="Sí" sourceRef="G_01" targetRef="G_02" />
    <bpmn:sequenceFlow id="F_07" name="No" sourceRef="G_01" targetRef="AC_04" />
    <bpmn:sequenceFlow id="F_08" sourceRef="AC_04" targetRef="SP_01" />
    <bpmn:sequenceFlow id="F_09" sourceRef="SP_01" targetRef="AC_05" />
    <bpmn:sequenceFlow id="F_10" sourceRef="AC_05" targetRef="G_02" />
    <bpmn:sequenceFlow id="F_11" sourceRef="G_02" targetRef="G_03" />
    <bpmn:sequenceFlow id="F_12" name="No" sourceRef="G_03" targetRef="G_00" />
    <bpmn:sequenceFlow id="F_13" name="Sí" sourceRef="G_03" targetRef="AC_06" />
    <bpmn:sequenceFlow id="F_14" sourceRef="AC_06" targetRef="AC_07" />
    <bpmn:sequenceFlow id="F_15" sourceRef="AC_07" targetRef="AC_08" />
    <bpmn:sequenceFlow id="F_16" sourceRef="AC_08" targetRef="G_04" />
    <bpmn:sequenceFlow id="F_17" name="Sí" sourceRef="G_04" targetRef="AC_09" />
    <bpmn:sequenceFlow id="F_18" name="No, lo retrasa u oculta" sourceRef="G_04" targetRef="AC_10" />
    <bpmn:sequenceFlow id="F_19" sourceRef="AC_10" targetRef="AC_11" />
    <bpmn:sequenceFlow id="F_20" sourceRef="AC_11" targetRef="G_05" />
    <bpmn:sequenceFlow id="F_21" sourceRef="AC_09" targetRef="G_05" />
    <bpmn:sequenceFlow id="F_22" sourceRef="G_05" targetRef="EE_01" />
    <bpmn:dataStoreReference id="DS_Plataforma" name="Plataforma digital" />
    <bpmn:dataStoreReference id="DS_RegistroFisico" name="Registro físico" />
    <bpmn:dataObjectReference id="DO_Cuaderno" name="Cuaderno de la asignatura" dataObjectRef="Obj_DO_Cuaderno" />
    <bpmn:dataObject id="Obj_DO_Cuaderno" />
    <bpmn:dataObjectReference id="DO_Recados" name="Cuaderno de recados" dataObjectRef="Obj_DO_Recados" />
    <bpmn:dataObject id="Obj_DO_Recados" />
    <bpmn:dataObjectReference id="DO_Reporte" name="Reporte físico de calificaciones" dataObjectRef="Obj_DO_Reporte" />
    <bpmn:dataObject id="Obj_DO_Reporte" />
    <bpmn:textAnnotation id="TA_Direccion"><bpmn:text>La Dirección supervisa el seguimiento académico (E-06).</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="TA_Plazo"><bpmn:text>El plazo para resolver la apelación depende de la situación (E-08).</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="TA_Firma"><bpmn:text>La firma en el cuaderno es la única constancia de recibido (E-04).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="AS_01" sourceRef="AC_11" targetRef="TA_Direccion" />
    <bpmn:association id="AS_02" sourceRef="SP_01" targetRef="TA_Plazo" />
    <bpmn:association id="AS_03" sourceRef="AC_03" targetRef="TA_Firma" />
  </bpmn:process>
