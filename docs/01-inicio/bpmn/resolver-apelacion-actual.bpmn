<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Process_ResolverApelacion" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Portal Académico (generador del equipo)" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_ResolverApelacion">
    <bpmn:participant id="Part_Apelacion" name="SP-01 Resolver la apelación (AS-IS)" processRef="Process_ResolverApelacion" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ResolverApelacion" name="Resolver la apelación (proceso actual)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="LaneA_Comite" name="Comité de Evaluación">
        <bpmn:flowNodeRef>SEA_01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GA_01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AP_01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GA_02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AP_04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AP_05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EEA_01</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LaneA_Docente" name="Docente">
        <bpmn:flowNodeRef>AP_02</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LaneA_Direccion" name="Dirección">
        <bpmn:flowNodeRef>AP_03</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="SEA_01" name="Apelación recibida en el cuaderno de recados">
      <bpmn:outgoing>FA_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="GA_01" name="">
      <bpmn:incoming>FA_01</bpmn:incoming>
      <bpmn:outgoing>FA_02</bpmn:outgoing>
      <bpmn:outgoing>FA_03</bpmn:outgoing>
      <bpmn:outgoing>FA_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="AP_01" name="AP-01 Analizar los puntos apelados">
      <bpmn:documentation>E-07, E-11</bpmn:documentation>
      <bpmn:incoming>FA_02</bpmn:incoming>
      <bpmn:outgoing>FA_05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AP_02" name="AP-02 Aportar la prueba y su criterio de calificación">
      <bpmn:documentation>E-11</bpmn:documentation>
      <bpmn:incoming>FA_03</bpmn:incoming>
      <bpmn:outgoing>FA_06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AP_03" name="AP-03 Participar en la gestión del caso">
      <bpmn:documentation>E-06, E-11</bpmn:documentation>
      <bpmn:incoming>FA_04</bpmn:incoming>
      <bpmn:outgoing>FA_07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="GA_02" name="">
      <bpmn:incoming>FA_05</bpmn:incoming>
      <bpmn:incoming>FA_06</bpmn:incoming>
      <bpmn:incoming>FA_07</bpmn:incoming>
      <bpmn:outgoing>FA_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="AP_04" name="AP-04 Emitir la resolución">
      <bpmn:documentation>E-11</bpmn:documentation>
      <bpmn:incoming>FA_08</bpmn:incoming>
      <bpmn:outgoing>FA_09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AP_05" name="AP-05 Comunicar la resolución a la persona encargada">
      <bpmn:documentation>E-11</bpmn:documentation>
      <bpmn:incoming>FA_09</bpmn:incoming>
      <bpmn:outgoing>FA_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EEA_01" name="Apelación resuelta y comunicada">
      <bpmn:incoming>FA_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="FA_01" sourceRef="SEA_01" targetRef="GA_01" />
    <bpmn:sequenceFlow id="FA_02" sourceRef="GA_01" targetRef="AP_01" />
    <bpmn:sequenceFlow id="FA_03" sourceRef="GA_01" targetRef="AP_02" />
    <bpmn:sequenceFlow id="FA_04" sourceRef="GA_01" targetRef="AP_03" />
    <bpmn:sequenceFlow id="FA_05" sourceRef="AP_01" targetRef="GA_02" />
    <bpmn:sequenceFlow id="FA_06" sourceRef="AP_02" targetRef="GA_02" />
    <bpmn:sequenceFlow id="FA_07" sourceRef="AP_03" targetRef="GA_02" />
    <bpmn:sequenceFlow id="FA_08" sourceRef="GA_02" targetRef="AP_04" />
    <bpmn:sequenceFlow id="FA_09" sourceRef="AP_04" targetRef="AP_05" />
    <bpmn:sequenceFlow id="FA_10" sourceRef="AP_05" targetRef="EEA_01" />
    <bpmn:textAnnotation id="TAA_Plazo"><bpmn:text>El plazo para resolver depende de la situación (E-08).</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="TAA_Caso"><bpmn:text>Caso real (E-11): una madre apeló varios puntos de una prueba; Comité, docente y Dirección gestionaron el caso y comunicaron la resolución.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Process_ResolverApelacion">
    <bpmndi:BPMNPlane id="Plane_Process_ResolverApelacion" bpmnElement="Collab_ResolverApelacion">
      <bpmndi:BPMNShape id="Part_Apelacion_di" bpmnElement="Part_Apelacion" isHorizontal="true">
        <dc:Bounds x="20" y="40" width="980" height="420" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LaneA_Comite_di" bpmnElement="LaneA_Comite" isHorizontal="true">
        <dc:Bounds x="50" y="40" width="950" height="140" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LaneA_Docente_di" bpmnElement="LaneA_Docente" isHorizontal="true">
        <dc:Bounds x="50" y="180" width="950" height="140" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LaneA_Direccion_di" bpmnElement="LaneA_Direccion" isHorizontal="true">
        <dc:Bounds x="50" y="320" width="950" height="140" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SEA_01_di" bpmnElement="SEA_01">
        <dc:Bounds x="100" y="92" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="80" y="132" width="120" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GA_01_di" bpmnElement="GA_01">
        <dc:Bounds x="190" y="85" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AP_01_di" bpmnElement="AP_01">
        <dc:Bounds x="290" y="70" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AP_02_di" bpmnElement="AP_02">
        <dc:Bounds x="290" y="210" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AP_03_di" bpmnElement="AP_03">
        <dc:Bounds x="290" y="350" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GA_02_di" bpmnElement="GA_02">
        <dc:Bounds x="480" y="85" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AP_04_di" bpmnElement="AP_04">
        <dc:Bounds x="580" y="70" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AP_05_di" bpmnElement="AP_05">
        <dc:Bounds x="740" y="70" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EEA_01_di" bpmnElement="EEA_01">
        <dc:Bounds x="920" y="92" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="890" y="132" width="100" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TAA_Plazo_di" bpmnElement="TAA_Plazo">
        <dc:Bounds x="600" y="230" width="330" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TAA_Caso_di" bpmnElement="TAA_Caso">
        <dc:Bounds x="600" y="350" width="330" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="FA_01_di" bpmnElement="FA_01">
        <di:waypoint x="136" y="110" />
        <di:waypoint x="190" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FA_02_di" bpmnElement="FA_02">
        <di:waypoint x="240" y="110" />
        <di:waypoint x="290" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FA_03_di" bpmnElement="FA_03">
        <di:waypoint x="215" y="135" />
        <di:waypoint x="215" y="250" />
        <di:waypoint x="290" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FA_04_di" bpmnElement="FA_04">
        <di:waypoint x="215" y="135" />
        <di:waypoint x="215" y="390" />
        <di:waypoint x="290" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FA_05_di" bpmnElement="FA_05">
        <di:waypoint x="410" y="110" />
        <di:waypoint x="480" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FA_06_di" bpmnElement="FA_06">
        <di:waypoint x="410" y="250" />
        <di:waypoint x="505" y="250" />
        <di:waypoint x="505" y="135" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FA_07_di" bpmnElement="FA_07">
        <di:waypoint x="410" y="390" />
        <di:waypoint x="505" y="390" />
        <di:waypoint x="505" y="135" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FA_08_di" bpmnElement="FA_08">
        <di:waypoint x="530" y="110" />
        <di:waypoint x="580" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FA_09_di" bpmnElement="FA_09">
        <di:waypoint x="700" y="110" />
        <di:waypoint x="740" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FA_10_di" bpmnElement="FA_10">
        <di:waypoint x="860" y="110" />
        <di:waypoint x="920" y="110" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
